  /* KaTeX DOM -> linear text (fallback when there is no <annotation> TeX source) */
  function katexDomToLinear(root) {
    const SKIP = /(^|\s)(strut|pstrut|vlist-s|frac-line|mspace|katex-mathml|sr-only)(\s|$)/;
    const topEm = n => {
      const m = (n.getAttribute("style") || "").match(/top:\s*(-?[\d.]+)em/);
      return m ? parseFloat(m[1]) : 0;
    };
    const vkids = n => {
      const vl = n.querySelector(".vlist");
      return vl ? [ ...vl.children ].filter(c => !/vlist-s/.test(c.getAttribute("class") || "")) : [];
    };
    function walk(n) {
      if (n.nodeType === 3) return n.textContent;
      if (n.nodeType !== 1) return "";
      const cls = n.getAttribute("class") || "";
      if (SKIP.test(cls)) return "";
      if (/(^|\s)mfrac(\s|$)/.test(cls)) {
        const k = vkids(n).filter(c => !c.querySelector(".frac-line"));
        if (k.length >= 2) return "((" + walk(k[k.length - 1]) + ")/(" + walk(k[0]) + "))";
      }
      if (/(^|\s)msupsub(\s|$)/.test(cls)) {
        const k = vkids(n);
        if (k.length === 1) return (topEm(k[0]) < -2.8 ? "^(" : "_(") + walk(k[0]) + ")";
        if (k.length === 2) return "_(" + walk(k[0]) + ")^(" + walk(k[1]) + ")";
      }
