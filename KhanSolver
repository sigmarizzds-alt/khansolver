    return null;
  }
  async function casSolve(q) {
    const prompt = [
      "Convert the exercise into ONE OR MORE commands, one per line, choosing only from:",
      "- EXPAND: <expression>",
      "- SIMPLIFY: <expression>",
      "- FACTOR: <polynomial>",
      "- SOLVE: <equation with exactly one variable>",
      "- EQUATION: <left>=<right> - for parts that ask to WRITE/SET UP an equation (the answer IS the equation itself)",
      "- RATIONAL: <expression> - for parts that ask to ADD/SUBTRACT/SIMPLIFY rational expressions (fractions with polynomial denominators). Copy the expression using / between numerator and denominator, keeping denominators factored",
      "- SOLVE-FOR <var>: <var> = <expression> - when the exercise asks to find an expression or value (like A) hidden inside an equation. FIRST rearrange the equation so <var> is alone on one side, writing the other side as products/quotients of polynomials. Example: SOLVE-FOR A: A = (6k^2-36k)(k^2+12k+36)/(k^2-36)",
      'Optionally prefix a part label before the command (e.g. "1) FACTOR: ...").',
      "Use ONLY ^ for powers, plain letters for variables, no LaTeX, no unicode superscripts.",
      "- Decimal commas (Vietnamese format like 6,2) must stay EXACTLY as written - never turn them into fractions or dots.",
      "- For SOLVE/EQUATION commands, copy the equation EXACTLY as it appears in the exercise - do NOT simplify, multiply, clear fractions, or rearrange. The CAS handles fractions like 1/8 and 4/5 natively.",
      "- The exercise may have MULTIPLE parts (a part that says write an equation, then a part that asks for the value): output ONE command for EVERY part, each prefixed with its part label.",
      "- If answering the final question (Tìm/Hỏi/bao nhiêu) needs a SYSTEM of two equations with two unknowns, or multi-step word-problem reasoning, reply UNSUPPORTED - the AI mode will handle it.",
      "Do NOT solve, do NOT explain, do NOT add anything else.",
      "If the exercise is NOT fully solvable by these commands (geometry/figures, word problems, multiple choice, percentages in context, tables, inequalities, matching/pairing exercises), reply with exactly: UNSUPPORTED",
      "",
      "EXERCISE:",
      '"""',
      q,
      '"""'
    ].join("\n");
    let out;
    try {
      out = await callAI({ prompt: prompt, temperature: 0, maxTokens: 400 });
    } catch (e) {
      return false;
    }
    if (/UNSUPPORTED/i.test(out)) return false;
    const results = [];
    const ops = [];
    for (const raw of out.split(/\n+/)) {
      const line = raw.trim();
      if (!line) continue;
      if (/UNSUPPORTED/i.test(line)) return false;
      const m = line.match(/(SOLVE-FOR\s*[A-Za-z]?|EXPAND|SIMPLIFY|FACTOR|SOLVE|EQUATION|RATIONAL)\s*:\s*(.+)$/i);
      if (!m) continue;
      const op = m[1].toUpperCase().replace(/\s.*/, "");
      ops.push(op);
      const expr = m[2].replace(/["']/g, "").trim().replace(/[.;]+$/, "");
      let res = null;
      try { res = casExec(op, expr); } catch (e) { res = null; }
      if (res == null) return false;
      if (lastKatexExpr && [ "RATIONAL", "EXPAND", "SIMPLIFY", "FACTOR" ].includes(op) && sameValue(lastKatexExpr, res) === false) return false;
      const lm = line.match(/^([^:]*?)\s*(?:SOLVE-FOR|EXPAND|SIMPLIFY|FACTOR|SOLVE|EQUATION|RATIONAL)/i);
      let label = lm ? lm[1].replace(/[):.\s]+$/, "").trim() : "";
      const lab = label ? (/^\d+$/.test(label) ? label + ") " : label + ": ") : "";
      results.push(lab + res);
    }
    const asksValue = /tìm|hỏi|bao nhiêu|find/i.test(q);
    const solvedSomething = ops.some(op => op === "SOLVE" || op === "EXPAND" || op === "SIMPLIFY" || op === "RATIONAL" || op === "FACTOR");
    if (asksValue && !solvedSomething) return false;
    let finalResults = results;
    if (lastChoices && lastChoices.length) {
      finalResults = results.map(r => {
        const L = matchChoiceLetter(r, lastChoices);
        return L ? "câu trắc nghiệm = " + L + " ; " + r : r;
      });
    }
    const seen = new Set();
    const deduped = finalResults.filter(r => { const k = r.replace(/\s+/g, ""); if (seen.has(k)) return false; seen.add(k); return true; });
    if (!deduped.length) return false;
    lastAnswer = deduped.join(" ; ");
    resultEl.innerHTML = answerCard(lastAnswer)
      + '<div class="ka-note">' + ic("num") + " Giải bằng CAS-lite — máy tính cục bộ, kiểm chứng bằng nhân ngược (không phụ thuộc AI suy luận).</div>";
    return true;
  }

