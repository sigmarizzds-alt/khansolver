  /* ---------------- Main solve ---------------- */
  let busy = false;
  async function solve() {
    if (busy) return;
    busy = true;
    solveBtn.disabled = true;
    solveBtn.innerHTML = ic("clock", 14) + " Đang giải…";
    try {
      if (!hasExerciseNodes()) {
        setStatus("Đang chờ đề bài tải xong…");
        await waitForExercise(6000);
      }
      let q = extractQuestion();
      if (!q) throw new Error("Không tìm thấy đề bài. Hãy mở một trang có câu hỏi rồi thử lại.");
      if (!hasExerciseNodes() && /Chuyển đến phần nội dung|Điều khoản sử dụng/i.test(q)) {
        throw new Error("Chưa thấy khung bài tập trên trang (trang có thể đang tải hoặc đang chuyển câu). Chờ câu hỏi hiện đủ rồi bấm Giải bài lại.");
      }
      const qRaw = q;
      q = augmentChoices(q);
      lastKatexExpr = "";
      lastDbg = [];
      if (lastQuestionEl) {
        const kat = extractKatexMath(lastQuestionEl);
        if (kat.length) q += "\n\n[Bieu thuc toan tren trang - dang tuyen tinh]:\n" + kat.join("\n");
        if (kat.length === 1) lastKatexExpr = kat[0].replace(/=\s*$/, "");
      }
      if (isThinQuestion(q)) {
        const scanned = pageMathScan();
        lastDbg.push("pageMathScan=" + JSON.stringify(scanned));
        if (scanned.length) {
          q += "\n\n[Biểu thức quét toàn trang]:\n" + scanned.join("\n");
          if (/phân tích|factor/i.test(q)) {
            for (const ln of scanned) {
              try {
                const r = casFactor(ln.replace(/=\s*$/, ""));
                if (r && finishCas(r)) {
                  showQ(q);
                  setStatus("Xong ✓ (quét công thức toàn trang + CAS phân tích nhân tử).");
                  return;
                }
              } catch (e6) {}
            }
          }
        }
      }
      if (isThinQuestion(q) && lastQuestionEl) {
        setStatus("Đề không có công thức dạng chữ — đang đọc biểu thức từ ảnh chụp…");
        try {
          const imgs = await captureQuestionImages(lastQuestionEl);
          lastDbg.push("images=" + imgs.length);
          if (imgs.length) {
            const exprTxt = (await callAI({
              prompt: buildReadExprPrompt(q),
              images: imgs,
              model: state.visionModels[state.provider],
              temperature: 0,
              maxTokens: 512
            })).trim();
            lastDbg.push("vision=" + JSON.stringify(exprTxt.slice(0, 200)));
            if (exprTxt && !/^NONE/i.test(exprTxt) && /[0-9]/.test(exprTxt)) {
              q += "\n\n[Biểu thức đọc từ ảnh]:\n" + exprTxt;
              if (/phân tích|factor/i.test(q)) {
                for (const ln of exprTxt.split("\n")) {
                  try {
                    const r = casFactor(ln.replace(/^[-•*\s]+/, "").trim());
                    if (r && finishCas(r)) {
                      showQ(q);
                      setStatus("Xong ✓ (đọc đề từ ảnh + CAS phân tích nhân tử).");
                      return;
                    }
                  } catch (e5) {}
                }
              }
            }
          }
        } catch (e) { lastDbg.push("visionErr=" + String(e && e.message || e).slice(0, 200)); }
      }
      showQ(q);
      console.log("[Khansolver] đề đọc được:\n" + q);

      const trap = await tryIsoTrapezoid(q);
      if (trap) {
        lastAnswer = trap.answer;
        resultEl.innerHTML = answerCard(trap.answer) + '<div class="ka-note">' + ic("num") + " " + renderInline(trap.note) + "</div>";
        setStatus("Xong ✓ (hình thang cân). Hãy tự đối chiếu với hình rồi kéo điểm.");
        return;
      }

      const sp = splitNumberedParts(qRaw);
      if (sp && sp.parts.some(pt => isMatchPart(pt.text))) {
        if (!getKeys(state.provider).length) {
          openSettings();
          throw new Error("Chưa có API key cho " + state.provider + ' — dán key rồi bấm "Lưu cài đặt". ' + PROVIDERS[state.provider].keyHint);
        }
        const mp = await solveMultiPart(sp);
        lastAnswer = mp.answer;
        resultEl.innerHTML = mp.html + '<div class="ka-note">' + ic("book") + " " + mp.note + "</div>";
        setStatus("Xong ✓ (bài " + sp.parts.length + " phần).");
        return;
      }

      const pyth = tryPythagorean(q);
      if (pyth) {
        lastAnswer = pyth;
        resultEl.innerHTML = answerCard(pyth) + '<div class="ka-note">' + ic("num") + " Kiểm tra a²+b²=c² bằng máy tính cục bộ.</div>";
        setStatus("Xong ✓");
        return;
      }

      const direct = isMatchingExercise(q) ? null : tryDirectCas(q);
      if (direct && finishCas(direct)) {
        setStatus("Xong ✓ (CAS trực tiếp - chính xác tuyệt đối, không cần AI). Hãy tự điền đáp án vào bài nhé.");
        return;
      }
      if (state.solveMode === "cas") {
        const casDone = await casSolve(q);
        if (casDone) {
          setStatus("Xong ✓ (CAS-lite — đã kiểm chứng bằng nhân ngược). Hãy tự điền đáp án vào bài nhé.");
          return;
        }
        setStatus("CAS không hỗ trợ dạng này — chuyển sang AI đầy đủ…");
      }
      if (!getKeys(state.provider).length) {
        openSettings();
        throw new Error("Chưa có API key cho " + state.provider + ' — dán key rồi bấm "Lưu cài đặt". ' + PROVIDERS[state.provider].keyHint);
      }
      let official = "";
      const om = q.match(/^[ \t]*(?:Đáp\s*án|Answer)[ \t]*[:：][ \t]*(.+)$/m);
      if (om && om[1].trim().length > 1) official = om[1].trim();
      if (!official) {
        const om2 = q.match(/^[ \t]*(?:Đáp\s*án|Answer)[ \t]*[:：][ \t]*$/m);
        if (om2) {
          const after = q.slice(om2.index).split("\n").slice(1).find(l => l.trim().length > 1);
          if (after) official = after.trim();
        }
      }
      if (official && official.length > 2 && official.length < 90) {
        const short = official.includes("=") ? official.split("=").pop().trim() : official;
        lastAnswer = short;
        resultEl.innerHTML = answerCard(short) + '<div class="ka-note">' + ic("book") + " Nguồn: lời giải chính thức của Khan Academy đang mở trên trang.</div>";
        setStatus("Xong ✓ (dùng luôn đáp án chính thức, không cần hỏi AI).");
        return;
      }
      let images = [];
      if (state.sendImages && lastQuestionEl && hasFigure(lastQuestionEl)) {
        setStatus("Đang chụp khu vực bài tập…");
        try { images = await captureQuestionImages(lastQuestionEl); } catch (e) { images = []; }
      }
      if (isMatchingExercise(q)) {
        setStatus("Bài ghép cặp — đang phân tích từng mục…");
        const visionOk2 = VISION_RE.test(state.models[state.provider]);
        const matchText = await callAI({
          prompt: buildMatchPrompt(q),
          images: visionOk2 ? images : [],
          model: state.models[state.provider],
          temperature: 0.2
        });
        lastAnswer = extractAnswer(matchText);
        if (!lastAnswer) throw new Error("Không ghép được cặp — thử bấm lại hoặc đổi model.");
        resultEl.innerHTML = answerCard(lastAnswer);
        setStatus("Xong ✓ Kéo các mục theo cặp đã ghép nhé.");
        return;
      }
      let transcription = "";
      if (images.length) {
        setStatus("Bước 1/3 — đang chép chi tiết hình vẽ…");
        try {
          transcription = (await callAI({
            prompt: buildTranscribePrompt(q),
            images: images,
            model: state.visionModels[state.provider],
            temperature: 0,
            maxTokens: 1024
          })).replace(/\n?\s*FINAL:.*$/i, "").trim();
        } catch (e) { transcription = ""; }
      }
      if (state.highAccuracy) {
        const solverModel = state.models[state.provider];
        const visionModel = state.visionModels[state.provider];
        let attempts = [];
        let lastErr = null;
        const plan = [
          { model: solverModel, recheck: false, tag: "solver+chép hình", trans: true },
          { model: visionModel, recheck: false, tag: "vision", trans: false },
          { model: solverModel, recheck: true, tag: "solver+đề gốc", trans: false }
        ];
        for (let i = 0; i < plan.length; i++) {
          const p = plan[i];
          setStatus("Bước 2/3 — lượt " + (i + 1) + "/3 (" + p.tag + ")…");
          try {
            attempts.push(await solveOnce(q, p.trans ? transcription : "", images, .7, p.model, p.recheck));
          } catch (e) {
            lastErr = e;
            if (/API key|401|403/i.test(e.message || "")) break;
          }
        }
        if (!attempts.length) throw new Error(lastErr && lastErr.message || "Mọi lượt giải đều lỗi.");
        const usable = attempts.filter(a => !isNAAnswer(a.final));
        if (!usable.length) throw new Error("Model trả về N/A — script chưa đọc được biểu thức của đề (có thể nằm trong hình). Mở mục 'Đề đọc được' bên dưới để kiểm tra, bật 'Chụp & gửi ảnh' và dùng model có vision.");
        attempts = usable;
        const selfConsistent = attempts.filter(a => a.checkOk !== false);
        if (selfConsistent.length && selfConsistent.length < attempts.length) {
          setStatus("Đã loại " + (attempts.length - selfConsistent.length) + " lượt giải tự mâu thuẫn (CHECK ORIGINAL ≠ ANSWER)…");
          attempts = selfConsistent;
        }
        const groups = groupAnswers(attempts.map(a => a.final));
        const consistent = groups.length === 1;
        let chosen, localOk = null, localMsg = "";
        if (!groups.length) {
          chosen = attempts[0];
          chosen.final = chosen.final || extractAnswer(chosen.text) || "(không rõ)";
        } else {
          const verdicts = groups.map(g => localVerifyAnswer(q, attempts[g[0]].final));
          const passIdx = verdicts.findIndex(v => v.ok === true);
          if (passIdx >= 0) {
            chosen = attempts[groups[passIdx][0]];
            localOk = true;
            localMsg = verdicts[passIdx].msg || "";
          } else {
            chosen = attempts[groups[0][0]];
            const bad = verdicts.find(v => v.ok === false);
            if (bad) { localOk = false; localMsg = bad.msg || ""; }
          }
        }
        if (!consistent && groups.length > 1 && localOk !== true) {
          setStatus("Bước 3/3 — đáp án chưa thống nhất, đang thẩm định…");
          try {
            const judgeText = await callAI({
              prompt: buildAdjudicatePrompt(q, transcription, attempts, localOk === false ? localMsg : ""),
              temperature: .2
            });
            chosen = { text: judgeText, final: extractAnswer(judgeText) };
            const jv = localVerifyAnswer(q, chosen.final);
            if (jv.ok === true) { localOk = true; localMsg = jv.msg || ""; }
            else if (jv.ok === false) { localOk = false; localMsg = jv.msg || ""; }
          } catch (e) {}
        }
        if (localOk === false) {
          setStatus("Các đáp án đều rớt kiểm chứng thay số — giải lại kèm phản ví dụ…");
          try {
            const rescue = await callAI({
              prompt: buildRescuePrompt(q, transcription, attempts, localMsg),
              temperature: .2
            });
            const rFinal = extractAnswer(rescue);
            const rv = localVerifyAnswer(q, rFinal);
            if (rv.ok !== false) {
              chosen = { text: rescue, final: rFinal || "(không rõ)" };
              if (rv.ok === true) { localOk = true; localMsg = rv.msg || localMsg; }
            }
          } catch (e) {}
        }
        let gateCorrected = null;
        let gateFailed = false;
        if (localOk !== true) {
          try {
            setStatus("Đang kiểm chứng đáp án được chọn…");
            const gate = await callAI({
              prompt: buildGatePrompt(q, chosen.final || "", localOk === false ? localMsg : ""),
              temperature: 0,
              maxTokens: 6000
            });
            const gm = gate.match(/ĐÁP ÁN ĐÚNG:\s*(.+)/i);
            if (/SAI/i.test(gate.slice(0, 60)) && gm) {
              const cand = gm[1].trim();
              const gv = localVerifyAnswer(q, cand);
              if (gv.ok === true) gateCorrected = cand;
            }
          } catch (e) { gateFailed = true; }
        }
        if (gateCorrected) chosen = { text: "", final: gateCorrected };
        lastAnswer = chosen.final || "(không rõ)";
        resultEl.innerHTML = answerCard(lastAnswer)
          + (localOk === true ? '<div class="ka-note"><span class="ka-ok">' + ic("num") + " Đã kiểm chứng bằng cách thay số vào đề</span>" + (localMsg ? " — " + renderInline(localMsg) : "") + ".</div>" : "")
          + (localOk === false ? '<div class="ka-warn">' + ic("num") + " Kiểm chứng thay số: " + renderInline(localMsg || "đáp án không khớp đề") + " — hãy xem lại!</div>" : "")
          + (gateCorrected ? '<div class="ka-warn">' + ic("gate") + " Cổng kiểm chứng đã loại đáp án sai của các lượt giải — đáp án trên đã được sửa.</div>" : "")
          + (gateFailed && localOk !== true ? '<div class="ka-note">' + ic("warn") + " Cổng kiểm chứng không chạy được — kết quả chỉ dựa vào bỏ phiếu, nên tự đối chiếu.</div>" : "")
          + '<div class="ka-sub">' + ic("clipboard") + " Các lượt giải độc lập</div>"
          + attempts.map(a => {
            const v = localVerifyAnswer(q, a.final);
            return '<span class="ka-chip">' + splitParts(a.final).map(renderInline).join(" · ").replace(/^$/, "?") + (v.ok === true ? " ✓" : v.ok === false ? " ✗" : "") + "</span>";
          }).join("")
          + (consistent && localOk !== false ? '<div class="ka-note"><span class="ka-ok">✓ Ba lượt giải thống nhất</span> — độ tin cậy cao.</div>' : localOk !== true ? '<div class="ka-warn">' + ic("alert") + " Các lượt giải bất đồng — đã chọn/chỉnh theo kiểm chứng thay số.</div>" : "");
        setStatus("Xong ✓");
      } else {
        setStatus("Đang giải (chế độ nhanh)…");
        const attempt = await solveOnce(q, transcription, images, .3);
        let ans = attempt.final || extractAnswer(attempt.text) || "(không rõ)";
        if (isNAAnswer(ans)) throw new Error("Model trả về N/A — script chưa đọc được biểu thức của đề. Mở mục 'Đề đọc được' để kiểm tra, bật 'Chụp & gửi ảnh' và dùng model có vision.");
        let localMsg = "";
        const lv = localVerifyAnswer(q, ans);
        if (lv.ok === true) {
          lastAnswer = ans;
          resultEl.innerHTML = answerCard(ans) + '<div class="ka-note"><span class="ka-ok">' + ic("num") + " Đã kiểm chứng bằng cách thay số vào đề</span>" + (lv.msg ? " — " + renderInline(lv.msg) : "") + ".</div>" + '<details class="ka-sol"><summary>' + ic("note") + ' Xem lời giải</summary><div class="ka-sol-body">' + renderSolution(attempt.text) + "</div></details>";
          setStatus("Xong ✓ (đã kiểm chứng thay số).");
        } else {
          if (lv.ok === false) localMsg = lv.msg || "";
          setStatus("Đang kiểm tra lại đáp án…");
          let corrected = null;
          try {
            const check = await callAI({
              prompt: buildVerifyPrompt(q, attempt.text),
              temperature: 0,
              maxTokens: 6000
            });
            const cm = check.match(/SAI\s*—\s*ĐÁP ÁN ĐÚNG:\s*(.+)/i);
            if (cm) {
              const cand = cm[1].trim();
              const cv = localVerifyAnswer(q, cand);
              if (cv.ok !== false) {
                corrected = cand;
                if (cv.ok === true) localMsg = cv.msg || "";
              }
            }
          } catch (e) {}
          if (corrected) ans = corrected;
          lastAnswer = ans;
          resultEl.innerHTML = answerCard(ans)
            + (corrected ? '<div class="ka-warn">' + ic("search") + " Lượt kiểm tra đã sửa đáp án.</div>" : "")
            + (lv.ok === false ? '<div class="ka-warn">' + ic("num") + " Kiểm chứng thay số: " + renderInline(localMsg || "đáp án không khớp đề") + " — hãy xem lại!</div>" : '<div class="ka-note">' + ic("warn") + " Chưa kiểm chứng được bằng thay số — nên tự đối chiếu.</div>")
            + '<details class="ka-sol"><summary>' + ic("note") + ' Xem lời giải</summary><div class="ka-sol-body">' + renderSolution(attempt.text) + "</div></details>";
          setStatus("Xong ✓");
        }
      }
    } catch (e) {
      setStatus("❌ " + (e.message || e), true);
      resultEl.innerHTML = '<div class="ka-warn">' + renderInline(String(e.message || e)) + "</div>";
    } finally {
      busy = false;
      solveBtn.disabled = false;
      solveBtn.innerHTML = ic("sparkles", 15) + " Giải bài";
    }
  }
  solveBtn.addEventListener("click", solve);

  /* ---------------- Copy ---------------- */
  const SUP_INV = { "⁰": "0", "¹": "1", "²": "2", "³": "3", "⁴": "4", "⁵": "5", "⁶": "6", "⁷": "7", "⁸": "8", "⁹": "9" };
  const toCaret = s => String(s || "").replace(/[⁰¹²³⁴⁵⁶⁷⁸⁹]+/g, m => "^" + m.split("").map(d => SUP_INV[d]).join(""));
  $("ka-copy").addEventListener("click", async () => {
    if (!lastAnswer) {
      setStatus('Chưa có đáp án để copy — bấm "Giải bài" trước.', true);
      return;
    }
    const copyText = toCaret(lastAnswer);
    try {
      await navigator.clipboard.writeText(copyText);
      setStatus("Đã copy đáp án (dạng x^10) vào clipboard ✓");
    } catch (e) {
      try {
        const ta = document.createElement("textarea");
        ta.value = copyText;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
        setStatus("Đã copy đáp án (dạng x^10) vào clipboard ✓");
      } catch (e2) {
        setStatus("Không copy được — hãy bôi đen đáp án và copy tay.", true);
      }
    }
  });

  /* ---------------- Video skipping ---------------- */
  function findVideo() {
    return [ ...document.querySelectorAll("video") ].find(v => {
      const r = v.getBoundingClientRect();
      return r.width >= 200 && r.height >= 120;
    }) || null;
  }
  function findNextButton() {
    return [ ...document.querySelectorAll('button, a[role="button"]') ].find(b => /^(tiếp theo|next)$/i.test((b.textContent || "").trim().replace(/\s+/g, " "))) || null;
  }
  let skippingVideo = false;
  async function skipVideo() {
    if (skippingVideo) return;
    const v = findVideo();
    if (!v) { setStatus("Không thấy video trên trang này.", true); return; }
    skippingVideo = true;
    const btn = $("ka-video");
    btn.disabled = true;
    btn.innerHTML = ic("ff", 14) + " Đang tua…";
    try {
      v.muted = true;
      try { await v.play(); } catch (e) {}
      if (isFinite(v.duration) && v.duration > 0) v.currentTime = Math.max(0, v.duration - 1.5);
      await new Promise(res => {
        const done = () => { v.removeEventListener("ended", done); res(); };
        v.addEventListener("ended", done);
        setTimeout(done, 20000);
      });
      await new Promise(r => setTimeout(r, 800));
      const next = findNextButton();
      if (next) {
        next.click();
        setStatus("Đã tua hết video và bấm Tiếp theo.");
      } else {
        setStatus("Video đã hết nhưng không thấy nút Tiếp theo — bấm tay nhé.", true);
      }
    } finally {
      skippingVideo = false;
      btn.disabled = false;
      btn.innerHTML = ic("ff", 14) + " Video";
    }
  }
  $("ka-video").addEventListener("click", skipVideo);
  $("ka-debug").addEventListener("click", async () => {
    try { extractQuestion(); } catch (e) {}
    const el = lastQuestionEl;
    const cnt = (sel, root) => { try { return (root || document).querySelectorAll(sel).length; } catch (e) { return -1; } };
    const info = [
      "URL: " + location.href,
      "UA: " + navigator.userAgent,
      "selectors: " + QUESTION_SELECTORS.map(x => x + "=" + cnt(x)).join(" | "),
      "page katex=" + cnt(".katex") + " math=" + cnt("math") + " mq=" + cnt(".mq-math-mode") + " img=" + cnt("img") + " svg=" + cnt("svg") + " canvas=" + cnt("canvas") + " iframe=" + cnt("iframe"),
      "el: " + (el ? el.tagName + "." + String(el.className).slice(0, 80) + " textLen=" + (el.innerText || "").length + " katex=" + cnt(".katex", el) : "none"),
      "pageMathScan: " + JSON.stringify(pageMathScan()),
      "Q: " + JSON.stringify(lastQ || ""),
      "DBG: " + lastDbg.join(" ; "),
      "HTML: " + (el ? el.outerHTML.replace(/<svg[\s\S]*?<\/svg>/g, "<svg/>").slice(0, 3000) : "")
    ].join("\n");
    try {
      await navigator.clipboard.writeText(info);
      setStatus("Đã copy thông tin debug ✓ — dán gửi cho mình.");
    } catch (e) {
      try {
        const ta = document.createElement("textarea");
        ta.value = info; ta.style.position = "fixed"; ta.style.opacity = "0";
        document.body.appendChild(ta); ta.select(); document.execCommand("copy"); ta.remove();
        setStatus("Đã copy thông tin debug ✓ — dán gửi cho mình.");
      } catch (e2) { setStatus("Không copy được debug.", true); }
    }
  });
  setInterval(() => {
    const v = findVideo();
    $("ka-video").style.display = v ? "" : "none";
    if (v && state.autoSkipVideo && !skippingVideo && isFinite(v.duration) && v.duration > 30) skipVideo();
  }, 2000);

  document.addEventListener("keydown", e => {
    if (e.altKey && !e.ctrlKey && !e.metaKey && (e.key === "s" || e.key === "S")) {
      e.preventDefault();
      if (!busy) solve();
    }
  });
  try { if (ksBoot) ksBoot.done(); } catch (e) {}
})();
